{
  "manifest_version": 3,
  "name": "ClarityLens — Smart Page Distiller & Focus Reader",
  "version": "1.0.0",
  "description": "Distill any webpage into key takeaways, decode dense text with readability metrics, highlight core concepts, read distraction-free, and clip notes locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open ClarityLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}

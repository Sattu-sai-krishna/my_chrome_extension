{
  "manifest_version": 3,
  "name": "WebSlinger — Spider-Man Browser Companion",
  "version": "1.0.0",
  "description": "Shoot webs on any webpage, activate Spidey-Sense link alerts, switch Spider-Suits, and play the Web-Swinger rooftop mini-game.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Activate WebSlinger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

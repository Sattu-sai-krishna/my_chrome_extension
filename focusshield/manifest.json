{
  "manifest_version": 3,
  "name": "FocusShield — Pomodoro Timer & Mindful Site Blocker",
  "version": "1.0.0",
  "description": "Stay in deep focus with a live badge countdown timer, mindful distraction blocking during focus sprints, and daily focus stats.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open FocusShield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
